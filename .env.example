# Copy to .env (gitignored) for local / Pi runs. Never commit the real file.
NIE_PASSPORT=
NIE_NAME=
NIE_COUNTRY=IRLANDA
NTFY_TOPIC=
NTFY_ADMIN_TOPIC=
# Label for the log, e.g. mac or pi
MONITOR_HOST=mac
# Checkout of the data branch the log is pushed to (needed for the watchdog). The Mac/Pi
# installers set this to data; leave blank for a one-off check that shouldn't be pushed.
DATA_DIR=
# The portal's firewall blocks headless Chrome, so keep a real (headed) window: it's minimised
# straight after launch and reused, so nothing pops up. MINIMISED=0 leaves it on screen.
HEADED=1
MINIMISED=1
